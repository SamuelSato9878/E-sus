# URL base da API do backend (obrigatoriamente HTTPS), sem barra no final.
# Ex.: EXPO_PUBLIC_API_URL=https://api.exemplo.com.br
# Enquanto estiver vazia, o app usa o banco local (SQLite) para testes.
# Para usar um valor só na sua máquina, crie um .env.local (já ignorado pelo git).
# Atenção: variáveis EXPO_PUBLIC_ ficam visíveis no app — não coloque segredos aqui.
EXPO_PUBLIC_API_URL=
